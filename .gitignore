# dependencies
node_modules
dist
dist-ssr
*.local

# env (keep example)
.env
.env.*
!.env.example

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# testing / CI artifacts
/coverage
/test-results/
/playwright-report/

# legacy Next.js artifacts (should not regenerate)
/.next/
**/.next/
/out/

# External dev cache / mirrored paths (NTFS dev quirk — never commit)
/home/
/run/
**/zaidos-next-dev/

# misc
.DS_Store
*.pem
*.tsbuildinfo
.vercel

# generated evidence dumps
.omo/evidence/lh-baseline.json

# editor / agent
.cursor/

# local scratch / duplicate trees
tmp/
macos-sim/

# wallpaper originals — app serves /Wallpaper/optimized/*.webp
public/Wallpaper/*
!public/Wallpaper/optimized/
!public/Wallpaper/optimized/**

# picture originals — app serves /pictures/optimized/*.webp
public/pictures/*
!public/pictures/optimized/
!public/pictures/optimized/**

# image originals — app serves /images/optimized/*.webp (+ lockscreen-opt.webp)
public/images/*
!public/images/optimized/
!public/images/optimized/**
!public/images/lockscreen-opt.webp
