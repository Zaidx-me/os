# /api/contact — Resend email relay. Read server-side only.
# The real contact email is PII: keep it in CONTACT_TO_EMAIL, never in code.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# After verifying zaidx.me in Resend (DNS records in Cloudflare):
RESEND_FROM=ZaidOS <hello@zaidx.me>
# Optional inbound: Cloudflare Email Routing can forward hello@zaidx.me → your Gmail.

# /api/chat (todo 32) — OpenAI-compatible LLM relay. Read server-side only.
# When LLM_API_KEY is unset, ZaidGPT falls back to the offline knowledge base.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Nemotron and other reasoning models need more headroom (default 1024).
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=45000

# /api/browser/session — Notte cloud browser embed (true browsing for X-Frame blocked sites).
# Get a key at https://console.notte.cc. When unset, Browser falls back to can-embed + iframe.
NOTTE_API_KEY=

# /api/music — Jamendo + Freesound CC catalogs. Read server-side only.
# Register at https://developer.jamendo.com/ and https://freesound.org/apiv2/apply/
# When unset, Music falls back to bundled SoundHelix demo tracks.
JAMENDO_CLIENT_ID=
FREESOUND_API_KEY=
